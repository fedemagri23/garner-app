generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/pricing"
}

datasource db {
  provider = "postgresql"
}

/// Where a price came from. Source affects how much a price is trusted, never
/// whether it enters the pipeline: every source goes through the same checks.
enum PriceSourceType {
  /// Typed in by a user who saw it on a shelf.
  USER_REPORTED
  /// Typed in with a photo the evidence store confirmed exists.
  USER_WITH_EVIDENCE
  /// Recorded as the actual price of a purchase in a completed shopping trip.
  PURCHASE_CONFIRMED
  /// Imported from a supermarket feed (phase 6).
  EXTERNAL_API
}

/// The outcome of trust evaluation.
enum PriceObservationStatus {
  /// Eligible to shape derived prices.
  ACCEPTED
  /// Kept, but held out of derived prices until independently confirmed.
  FLAGGED
  /// Kept for abuse detection only; never used as a price.
  REJECTED
}

/// A raw price seen at one store at one moment.
///
/// Operational data, not history: rows are pruned after the retention window.
/// The long-lived record is the daily aggregate phase 5 derives from these.
/// Product, store, user and session ids point into core_db and are plain
/// uuids — there are no foreign keys across databases.
model PriceObservation {
  id                String                 @id @default(uuid()) @db.Uuid
  productId         String                 @db.Uuid
  storeId           String                 @db.Uuid
  /// Price of one unit of the product as catalogued, in minor units.
  priceCents        Int
  currency          String                 @db.Char(3)
  /// When the price was seen, which for an offline client may be well before
  /// it was received.
  observedAt        DateTime               @db.Timestamptz(3)
  receivedAt        DateTime               @default(now()) @db.Timestamptz(3)
  sourceType        PriceSourceType
  status            PriceObservationStatus
  /// Internal review reason codes. Never returned to the contributor: telling
  /// an abuser which heuristic fired tells them how to avoid it.
  reviewReasons     String[]               @default([])
  userId            String?                @db.Uuid
  shoppingSessionId String?                @db.Uuid
  /// Unique per logical observation where the source has a natural identity,
  /// e.g. one purchased line of a trip. A retried ingestion hits this key and
  /// returns the existing row instead of inserting a second.
  dedupeKey         String?                @unique
  evidencePhotoKey  String?
  evidenceNote      String?

  /// Recent prices for a product at a store: the reference for deviation checks.
  @@index([productId, storeId, status, observedAt])
  @@index([productId, status, observedAt])
  /// A contributor's own history and their recent volume.
  @@index([userId, receivedAt])
  /// Retention pruning walks this.
  @@index([receivedAt])
  @@map("price_observations")
}

/// Ledger of shopping trips whose purchases have been turned into observations.
/// Lets the reconciliation sweep find completed trips that were missed without
/// re-processing every trip it has already handled.
model SessionContribution {
  sessionId        String   @id @db.Uuid
  userId           String   @db.Uuid
  observationCount Int
  /// Purchased lines with no actual price or no store, which cannot be observations.
  skippedCount     Int
  processedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([processedAt])
  @@map("session_contributions")
}

/// How an import run ended. PARTIAL means the source answered but some of what
/// it returned could not be used — an unmatched product, a price that failed
/// validation — which is normal and not a reason to alarm anyone.
enum ImportRunStatus {
  STARTED
  COMPLETED
  PARTIAL
  FAILED
}

/// How an external product was tied to a canonical one.
enum ProductMatchMethod {
  BARCODE
  EXTERNAL_ID
  NORMALIZED_IDENTITY
  MANUAL
}

enum ExternalProductLinkStatus {
  MATCHED
  /// Seen but not confidently matched; waits for a person to decide.
  UNMATCHED
  /// A person decided this external product has no canonical counterpart.
  IGNORED
}

/// A supermarket integration, as configured by a developer or administrator.
///
/// Registry only: how to talk to the source lives in its adapter, and its
/// credentials come from the environment, never from this row.
model ExternalPriceSource {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  slug                String           @unique
  /// The core_db supermarket whose stores this source prices.
  supermarketId       String           @db.Uuid
  /// Which adapter implementation runs it, e.g. `json-http`.
  adapterKey          String
  isEnabled           Boolean          @default(true)
  /// Hour of the UTC day the daily import is due. Sources differ in when
  /// their data is fresh, so this is per source rather than global.
  scheduleHourUtc     Int              @default(8)
  /// Non-secret adapter configuration: endpoints, page size, field names.
  config              Json             @default("{}")
  lastRunAt           DateTime?        @db.Timestamptz(3)
  lastSuccessfulRunAt DateTime?        @db.Timestamptz(3)
  lastStatus          ImportRunStatus?
  /// Reset by any run that completes; a rising count means a source needs a look.
  consecutiveFailures Int              @default(0)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  runs       ImportRun[]
  links      ExternalProductLink[]
  storeLinks ExternalStoreLink[]

  @@index([isEnabled, scheduleHourUtc])
  @@map("external_price_sources")
}

/// One execution of one source's import.
model ImportRun {
  id       String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  /// The scheduled slot this run belongs to, e.g. `2026-09-24`. Unique per
  /// source, so a retried or duplicated trigger resumes the same run instead
  /// of starting a second one.
  runKey   String

  status              ImportRunStatus @default(STARTED)
  startedAt           DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt          DateTime?       @db.Timestamptz(3)
  productsSeen        Int             @default(0)
  pricesSeen          Int             @default(0)
  observationsCreated Int             @default(0)
  matchedProducts     Int             @default(0)
  unmatchedProducts   Int             @default(0)
  skippedPrices       Int             @default(0)
  /// Why the run failed, or what went wrong in a partial run. Operator-facing.
  error               String?

  source ExternalPriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, runKey])
  @@index([sourceId, startedAt])
  @@map("import_runs")
}

/// What a source calls a product, and which canonical product that is.
///
/// An unmatched row is deliberately kept: it is the queue a person works
/// through. Nothing here ever creates a canonical product, because a wrong
/// automatic match splits a product's price history in two.
model ExternalProductLink {
  id                String                    @id @default(uuid()) @db.Uuid
  sourceId          String                    @db.Uuid
  externalProductId String
  productId         String?                   @db.Uuid
  externalName      String
  externalBarcode   String?
  matchMethod       ProductMatchMethod?
  status            ExternalProductLinkStatus @default(UNMATCHED)
  lastSeenAt        DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)

  source ExternalPriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalProductId])
  @@index([sourceId, status])
  @@map("external_product_links")
}

/// What a source calls a store, and which core_db store that is. Set by a
/// person: a mis-mapped store would file real prices against the wrong place.
model ExternalStoreLink {
  id              String   @id @default(uuid()) @db.Uuid
  sourceId        String   @db.Uuid
  externalStoreId String
  storeId         String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  source ExternalPriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalStoreId])
  @@map("external_store_links")
}
