generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/core"
}

datasource db {
  provider = "postgresql"
}

/// Who an entry in the catalog comes from. The team's are the reference;
/// shoppers' are visible but ranked by how much other people stand behind them.
enum CatalogOrigin {
  VERIFIED
  COMMUNITY
}

/// Where an entry stands in moderation. Only ACTIVE ones show in search.
enum ModerationStatus {
  ACTIVE
  UNDER_REVIEW
  HIDDEN
  MERGED
}

enum FlagTarget {
  PRODUCT
  STORE
}

enum FlagReason {
  DUPLICATE
  WRONG_INFO
  NOT_EXIST
  INAPPROPRIATE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

/// Account identity. Owned by the users domain; auth reads it through the
/// users domain's repository port, never by touching this table itself.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  /// es, en, de or pt: what push and email are written in.
  locale       String   @default("es") @db.VarChar(5)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens           RefreshToken[]
  preferences             UserPreferences?
  shoppingLists           ShoppingList[]
  shoppingSessions        ShoppingSession[]
  optimizationPreferences OptimizationPreferences?
  optimizationRequests    OptimizationRequest[]
  priceAlerts             PriceAlert[]
  notificationPreferences NotificationPreferences?
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  createdProducts         Product[]                @relation("ProductCreator")
  createdStores           StoreLocation[]          @relation("StoreCreator")
  createdChains           Supermarket[]            @relation("ChainCreator")
  productConfirmations    ProductConfirmation[]
  contentFlags            ContentFlag[]
  storePriceContributions StorePriceContributor[]

  @@map("users")
}

/// One row per issued refresh token. Tokens are stored hashed, and rotation
/// marks the previous row revoked so a replayed token can be detected.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Optional onboarding and personalization settings, one row per account.
/// Created lazily: an account without a row reads as the documented defaults,
/// so registration does not have to know this table exists.
model UserPreferences {
  userId         String   @id @db.Uuid
  latitude       Float?
  longitude      Float?
  locationLabel  String?
  searchRadiusKm Float    @default(5)
  /// Category slugs the user is interested in. Deliberately not a foreign key
  /// to `categories`: preferences belong to the users domain and categories to
  /// products, so the link is validated through the products module's port
  /// rather than welded together in the schema.
  interests      String[] @default([])
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// The unit a package is measured in. Mass and volume units are stored as
/// given and normalized to grams/millilitres by the domain, so price-per-unit
/// comparisons in later phases compare like with like.
enum UnitOfMeasure {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  UNIT
}

/// A browsable catalog category, optionally nested one or more levels deep
/// ("Dairy" → "Milk").
model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// The name in other languages, e.g. {"en": "Dairy", "de": "Milchprodukte"}.
  translations Json     @default("{}")
  slug         String   @unique
  parentId     String?  @db.Uuid
  /// MaterialCommunityIcons name the app ships with; departments only.
  icon         String?  @db.VarChar(60)
  /// Aisle order within the parent (or among departments).
  position     Int      @default(0)
  /// False once retired from the taxonomy; see replacedById.
  isActive     Boolean  @default(true)
  replacedById String?  @db.Uuid
  /// Search words per language, e.g. {"es": ["gaseosa", "refresco"]}.
  synonyms     Json     @default("{}")
  /// Open Food Facts category tags that map here, e.g. ["en:yogurts"].
  offTags      Json     @default("[]")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

/// A manufacturer or house brand. Separate from the product so "La Serenísima"
/// is one identity across every product it makes.
model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  /// Accent-stripped, lower-cased `name`. Product search matches against this
  /// rather than the display name, so a shopper typing "serenisima" finds
  /// "La Serenísima" — an ILIKE on the raw name would not.
  normalizedName String
  slug           String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([normalizedName])
  @@map("products_brands")
}

/// A canonical purchasable item — the identity every price in `pricing_db` and
/// `intelligence_db` points at.
///
/// Two rules shape this table:
///
/// 1. **Identity is stable.** A product carries no price and no store. Its id
///    survives renames, re-categorization and brand corrections, so price
///    history stays attached to the same thing it was recorded for. Products
///    are deactivated, never deleted, for the same reason.
/// 2. **A size is a product.** "Milk 1L" and "Milk 2L" are separate rows with
///    their own barcodes rather than variants of one product, because they are
///    separately purchasable and separately priced. That keeps every price
///    observation a plain reference to a product id.
model Product {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  /// Lower-cased, accent-stripped, space-collapsed `name`. Written by the
  /// domain, matched against by search, and the key product matching will use
  /// when external sources are imported in phase 6.
  normalizedName    String
  description       String?
  brandId           String?          @db.Uuid
  categoryId        String           @db.Uuid
  /// Package size in `unit`, e.g. 1 with LITER, or 500 with GRAM.
  packageSize       Decimal?         @db.Decimal(12, 3)
  unit              UnitOfMeasure    @default(UNIT)
  imageUrl          String?
  /// Where the picture comes from when it is not the team's: OPEN_FOOD_FACTS.
  imageSource       String?          @db.VarChar(40)
  isActive          Boolean          @default(true)
  /// Who it comes from; every entry that predates shoppers adding their own is the team's.
  origin            CatalogOrigin    @default(VERIFIED)
  /// The shopper who added it; null for the team's. Dropped if the account is deleted, the entry stays.
  createdById       String?          @db.Uuid
  moderationStatus  ModerationStatus @default(ACTIVE)
  /// For a MERGED entry, the one it became, so old ids still resolve.
  mergedIntoId      String?          @db.Uuid
  /// Ranking among equal text matches, derived from confirmations, price updates and flags (`rankingWeight`).
  weight            Int              @default(0)
  confirmationCount Int              @default(0)
  flagCount         Int              @default(0)
  lastActivityAt    DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  createdBy     User?                 @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmations ProductConfirmation[]
  brand         Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  barcodes      ProductBarcode[]

  shoppingListItems    ShoppingListItem[]
  shoppingSessionItems ShoppingSessionItem[]

  @@index([normalizedName])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([origin, moderationStatus, weight])
  @@index([createdById, createdAt])
  @@map("products")
}

/// A scanned code pointing at a product. A product may carry several (an EAN-13
/// plus a regional UPC-A); a code identifies exactly one product.
model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  /// Digits only — separators are stripped and the checksum validated by the
  /// domain before a code reaches this table.
  code      String   @unique
  productId String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

/// A chain or merchant — "Carrefour", not a particular branch of it.
model Supermarket {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  slug             String           @unique
  logoUrl          String?
  websiteUrl       String?
  isActive         Boolean          @default(true)
  origin           CatalogOrigin    @default(VERIFIED)
  createdById      String?          @db.Uuid
  moderationStatus ModerationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  createdBy User?           @relation("ChainCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stores    StoreLocation[]

  @@map("supermarkets")
}

/// A physical branch of a supermarket: where a price is actually paid, and the
/// unit optimization routes a shopper between.
model StoreLocation {
  id                 String           @id @default(uuid()) @db.Uuid
  supermarketId      String           @db.Uuid
  name               String
  addressLine        String
  city               String
  province           String?
  postalCode         String?
  country            String
  latitude           Float
  longitude          Float
  phone              String?
  /// IANA zone the opening hours are written in: 21:00 is a wall-clock time
  /// in a place, and "open now" has to read the clock of that place.
  timeZone           String           @default("America/Argentina/Buenos_Aires")
  isActive           Boolean          @default(true)
  origin             CatalogOrigin    @default(VERIFIED)
  createdById        String?          @db.Uuid
  moderationStatus   ModerationStatus @default(ACTIVE)
  /// Distinct products, and distinct people, with an accepted price here. Kept in
  /// step with `StorePriceContributor`; the shop is published at 10 products.
  pricedProductCount Int              @default(0)
  contributorCount   Int              @default(0)
  /// When a shopper-added shop became visible to everyone; null while private.
  /// The team's shops are published from the start, hence the default.
  publishedAt        DateTime?        @default(now()) @db.Timestamptz(3)
  flagCount          Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  supermarket       Supermarket             @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  createdBy         User?                   @relation("StoreCreator", fields: [createdById], references: [id], onDelete: SetNull)
  openingHours      StoreOpeningHours[]
  priceContributors StorePriceContributor[]

  shoppingListItems    ShoppingListItem[]
  shoppingSessions     ShoppingSession[]
  shoppingSessionItems ShoppingSessionItem[]

  @@index([supermarketId])
  /// Proximity search filters on a latitude/longitude bounding box before
  /// computing exact distances, so the composite index is the one that matters.
  @@index([latitude, longitude])
  @@index([city])
  @@index([origin, publishedAt])
  @@index([createdById, createdAt])
  @@map("store_locations")
}

/// One opening interval on one weekday. A store closed for lunch has two rows
/// for that day; a store closed all day has none.
model StoreOpeningHours {
  id              String @id @default(uuid()) @db.Uuid
  storeLocationId String @db.Uuid
  /// 0 = Sunday … 6 = Saturday, matching `Date#getDay`.
  dayOfWeek       Int
  /// Local wall-clock time as `HH:MM`.
  opensAt         String
  closesAt        String

  storeLocation StoreLocation @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)

  @@unique([storeLocationId, dayOfWeek, opensAt])
  @@index([storeLocationId])
  @@map("store_opening_hours")
}

/// How a list presents its items. MANUAL follows the order the user arranged.
enum ShoppingListSortMode {
  MANUAL
  NAME
  CATEGORY
  STORE
}

/// A plan made at home: what to buy, how much, and what it is expected to cost.
model ShoppingList {
  id        String               @id @default(uuid()) @db.Uuid
  ownerId   String               @db.Uuid
  name      String
  notes     String?
  /// ISO 4217. Every price on the list is in this currency, so totals never
  /// add amounts in different currencies. Fixed at creation.
  currency  String               @db.Char(3)
  sortMode  ShoppingListSortMode @default(MANUAL)
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items         ShoppingListItem[]
  sessions      ShoppingSession[]
  optimizations OptimizationRequest[]

  @@index([ownerId, updatedAt])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id                     String   @id @default(uuid()) @db.Uuid
  listId                 String   @db.Uuid
  productId              String   @db.Uuid
  /// Decimal so "1.5 kg of tomatoes" is expressible, not just whole units.
  quantity               Decimal  @db.Decimal(10, 3)
  notes                  String?
  /// Minor units (cents). What the user expects to pay per unit before the trip.
  expectedUnitPriceCents Int?
  selectedStoreId        String?  @db.Uuid
  /// Manual order; gaps are fine, only relative order matters.
  position               Int
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  list          ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  selectedStore StoreLocation? @relation(fields: [selectedStoreId], references: [id], onDelete: SetNull)

  @@index([listId, position])
  @@index([productId])
  @@map("shopping_list_items")
}

enum ShoppingSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

/// A real shopping trip started from a list.
///
/// The list's items are copied into the session when it starts. The trip is
/// what actually happened, so editing or deleting the list afterwards must not
/// rewrite it — which is also why `listId` survives as null when the list goes.
model ShoppingSession {
  id          String                @id @default(uuid()) @db.Uuid
  ownerId     String                @db.Uuid
  listId      String?               @db.Uuid
  listName    String
  currency    String                @db.Char(3)
  storeId     String?               @db.Uuid
  status      ShoppingSessionStatus @default(ACTIVE)
  startedAt   DateTime              @default(now()) @db.Timestamptz(3)
  pausedAt    DateTime?             @db.Timestamptz(3)
  completedAt DateTime?             @db.Timestamptz(3)
  abandonedAt DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  owner User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  list  ShoppingList?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  store StoreLocation?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items ShoppingSessionItem[]

  @@index([ownerId, status])
  @@index([listId, status])
  /// Finds recently completed trips, for the contributions reconciliation sweep.
  @@index([status, completedAt])
  @@map("shopping_sessions")
}

/// One line of a trip: what was planned, and — once bought — what was paid.
/// A purchased line is the Purchase the business model talks about.
model ShoppingSessionItem {
  id                     String    @id @default(uuid()) @db.Uuid
  sessionId              String    @db.Uuid
  /// The list item this line was copied from. Provenance only, not a foreign
  /// key: the list item may be edited or deleted while the trip stands.
  sourceListItemId       String?   @db.Uuid
  productId              String    @db.Uuid
  quantity               Decimal   @db.Decimal(10, 3)
  notes                  String?
  expectedUnitPriceCents Int?
  /// What was actually paid per unit. Overrides the expected price in totals.
  actualUnitPriceCents   Int?
  storeId                String?   @db.Uuid
  isPurchased            Boolean   @default(false)
  /// When the shopper marked it, as reported by the client — an offline client
  /// may sync long after the moment of purchase.
  purchasedAt            DateTime? @db.Timestamptz(3)
  position               Int
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  session ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  store   StoreLocation?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([sessionId, position])
  @@index([productId])
  @@map("shopping_session_items")
}

/// Which recommendation a shopper wants to act on. Every optimization returns
/// all three; this says which one is theirs by default.
enum OptimizationMode {
  CHEAPEST
  BEST_BALANCE
  SIMPLEST
}

enum OptimizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// A shopper's standing answer to "how far would you go to save money?".
/// Reusable: every optimization starts from these and may override them.
model OptimizationPreferences {
  userId                       String           @id @db.Uuid
  /// How many shops they are willing to visit in one trip.
  maxStores                    Int              @default(2)
  /// Extra kilometres they will accept over shopping at one store.
  maxAdditionalDistanceKm      Float            @default(5)
  maxAdditionalMinutes         Int              @default(20)
  /// What each extra stop has to save to be worth making, in minor units.
  minSavingsCentsPerExtraStore Int              @default(400)
  mode                         OptimizationMode @default(BEST_BALANCE)
  /// Chains to favour and chains to keep out of every recommendation.
  preferredSupermarketIds      String[]         @default([])
  excludedSupermarketIds       String[]         @default([])
  createdAt                    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("optimization_preferences")
}

/// One "where should I buy all this?" question, and its answer.
///
/// The constraints are copied onto the request rather than read from
/// preferences at render time, so a result always explains itself: it says
/// which limits produced it, even after the shopper changes their mind.
model OptimizationRequest {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String  @db.Uuid
  /// Null once the list is deleted; the answer still stands on its own.
  listId  String? @db.Uuid

  latitude  Float
  longitude Float
  /// How far from the shopper stores may be considered at all.
  radiusKm  Float

  maxStores                    Int
  maxAdditionalDistanceKm      Float
  maxAdditionalMinutes         Int
  minSavingsCentsPerExtraStore Int
  mode                         OptimizationMode
  preferredSupermarketIds      String[]         @default([])
  excludedSupermarketIds       String[]         @default([])

  status      OptimizationStatus @default(PENDING)
  requestedAt DateTime           @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?          @db.Timestamptz(3)
  completedAt DateTime?          @db.Timestamptz(3)
  error       String?

  /// The list contents plus the constraints, hashed. A repeated question with
  /// the same fingerprint reuses a recent answer instead of recomputing it.
  fingerprint String

  /// The plans, their store assignments and their totals. Held as one
  /// document because a result is a snapshot that is rendered whole and never
  /// queried field by field; the columns below are what listings need.
  result                Json?
  recommendedTotalCents Int?
  recommendedStoreCount Int?

  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  list  ShoppingList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([ownerId, requestedAt])
  @@index([listId, fingerprint, completedAt])
  @@map("optimization_requests")
}

/// What a shopper asked to be told about.
enum PriceAlertType {
  /// The price at a watched store falls to or below a figure they named.
  BELOW_THRESHOLD
  /// The price falls by a meaningful proportion, whatever it started at.
  PRICE_DROP
  /// Somewhere near them becomes the cheapest place to buy it.
  CHEAPER_NEARBY
}

enum NotificationCategory {
  PRICE_ALERT
  SHOPPING_REMINDER
}

enum NotificationStatus {
  /// Created, waiting for delivery — possibly until quiet hours end.
  PENDING
  SENT
  FAILED
}

/// A standing request to be told when a product's price does something.
///
/// Opt-in by construction: no alert exists until a shopper creates one, and
/// every alert names exactly what it watches.
model PriceAlert {
  id        String         @id @default(uuid()) @db.Uuid
  ownerId   String         @db.Uuid
  productId String         @db.Uuid
  type      PriceAlertType
  /// One store, or null to watch the product anywhere nearby.
  storeId   String?        @db.Uuid

  /// BELOW_THRESHOLD: the figure, in minor units.
  thresholdCents Int?
  /// PRICE_DROP: how much of a fall is worth a message, in percent.
  dropPercent    Int?
  /// Where "nearby" is measured from. Required for CHEAPER_NEARBY; any alert
  /// that has a place and a radius only hears about stores inside it.
  latitude       Float?
  longitude      Float?
  radiusKm       Float?
  /// What the figures are in. Prices in another currency never match, since
  /// 1.150 pesos and 1,15 euros are both "115" cents to a comparison. Null on
  /// alerts made before this existed: they match any currency, as they did.
  currency       String? @db.Char(3)

  isEnabled              Boolean   @default(true)
  /// When this alert last produced a notification, for throttling.
  lastTriggeredAt        DateTime? @db.Timestamptz(3)
  /// The price it last told them about, so the same news is not repeated.
  lastNotifiedPriceCents Int?
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notifications Notification[]

  /// Evaluating a price change walks this.
  @@index([productId, isEnabled])
  @@index([ownerId, createdAt])
  @@map("price_alerts")
}

/// How a shopper wants to be reached, and when they would rather not be.
model NotificationPreferences {
  userId                  String    @id @db.Uuid
  priceAlertsEnabled      Boolean   @default(true)
  remindersEnabled        Boolean   @default(true)
  /// Hours of the UTC day to stay silent in; a message raised then waits.
  quietHoursStartUtc      Int?
  quietHoursEndUtc        Int?
  /// The least time between two messages from one alert.
  minMinutesBetweenAlerts Int       @default(360)
  /// Email is opt-in: nothing is emailed until the account holder asks.
  emailEnabled            Boolean   @default(false)
  /// The consent trail: when email was last switched on, and last switched
  /// off — by the holder, or by the unsubscribe link in a message.
  emailOptedInAt          DateTime? @db.Timestamptz(3)
  emailOptedOutAt         DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// One message raised for one shopper, and what became of it.
model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  title     String
  body      String
  /// What it is about, for the client to link to.
  productId String?              @db.Uuid
  storeId   String?              @db.Uuid
  listId    String?              @db.Uuid
  alertId   String?              @db.Uuid

  /// For a price alert, the facts behind the words, so a client can say them
  /// in its own language: why it fired, and the price and the one before it
  /// in minor units. `title` and `body` stay for email and push, where the
  /// server has to write the message itself.
  reason             PriceAlertType?
  priceCents         Int?
  previousPriceCents Int?
  currency           String?         @db.Char(3)

  status    NotificationStatus @default(PENDING)
  /// Identifies the news, so the same message is never raised twice.
  dedupeKey String             @unique
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  /// When it may be delivered; later than createdAt during quiet hours.
  deliverAt DateTime           @default(now()) @db.Timestamptz(3)
  sentAt    DateTime?          @db.Timestamptz(3)
  readAt    DateTime?          @db.Timestamptz(3)
  error     String?

  user              User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert             PriceAlert?                   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  channelDeliveries NotificationChannelDelivery[]

  @@index([userId, createdAt])
  @@index([status, deliverAt])
  @@map("notifications")
}

/// How one notification fared on one channel. A retry after a partial failure
/// sends only to the channels still missing, so nobody gets the same email
/// twice because a push provider was down.
model NotificationChannelDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @db.Uuid
  /// `in-app`, `email`, and whatever channel is added next.
  channel        String
  sentAt         DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  /// Set once a channel has failed too often to keep trying.
  abandonedAt    DateTime? @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_channel_deliveries")
}

/// A phone that wants to be told things when the app is closed: the token
/// Expo's push service knows it by. A token belongs to one account at a time —
/// signing in on a phone another account used moves it — and is dropped when
/// the push service says the app is gone.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// "ExponentPushToken[…]": opaque, and unique across every account.
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Refreshed each time the app registers, so stale ones can be told apart.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// A shopper vouching that a product exists and is described right. One per person.
model ProductConfirmation {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@map("product_confirmations")
}

/// A shopper saying an entry is wrong, a duplicate, or does not exist. One per
/// person per entry; the target is a plain id because it is a product or a store.
model ContentFlag {
  id         String     @id @default(uuid()) @db.Uuid
  targetType FlagTarget
  targetId   String     @db.Uuid
  userId     String     @db.Uuid
  reason     FlagReason
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("content_flags")
}

/// That a person had an accepted price for a product at a shop. Rows are what
/// the shop's counters count (distinct products, distinct people) and make
/// recording the same fact twice a no-op. Prices live in another database.
model StorePriceContributor {
  id              String   @id @default(uuid()) @db.Uuid
  storeLocationId String   @db.Uuid
  productId       String   @db.Uuid
  userId          String   @db.Uuid
  firstAcceptedAt DateTime @default(now()) @db.Timestamptz(3)

  storeLocation StoreLocation @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeLocationId, productId, userId])
  @@index([storeLocationId])
  @@index([userId])
  @@map("store_price_contributors")
}

/// Who did what to the catalog: every entry added and every moderator decision.
/// Never shown to the person it is about.
model CatalogAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null when the actor's account was later deleted.
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String   @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("catalog_audit_log")
}
