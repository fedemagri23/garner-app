# The API as load tests run it: production mode, its own databases, and
# limits raised so the test measures the system rather than the throttle.
# Committed on purpose: it points only at local throwaway databases.
NODE_ENV=production
PORT=3100
CORE_DB_URL="postgresql://postgres:password@localhost:5433/core_db_load?schema=public"
PRICING_DB_URL="postgresql://postgres:password@localhost:5433/pricing_db_load?schema=public"
INTELLIGENCE_DB_URL="postgresql://postgres:password@localhost:5433/intelligence_db_load?schema=public"
REDIS_URL="redis://localhost:6379/2"
JWT_SECRET="load-test-secret-not-used-anywhere-real"
RATE_LIMIT_MAX=1000000
SWAGGER_ENABLED=false
LOG_FORMAT=json
EXTERNAL_SOURCE_SANDBOX_DIR=var/load-sandbox
EVIDENCE_STORAGE_DIR=var/load-evidence
TRUST_PROXY_HOPS=1
