# Application
NODE_ENV=development
PORT=3000

# Database URLs (one per logical database)
CORE_DB_URL="postgresql://postgres:password@localhost:5433/core_db?schema=public"
PRICING_DB_URL="postgresql://postgres:password@localhost:5433/pricing_db?schema=public"
INTELLIGENCE_DB_URL="postgresql://postgres:password@localhost:5433/intelligence_db?schema=public"

# Connections per database per process (three databases, three pools)
DATABASE_POOL_MAX=10

# Redis (cache + BullMQ)
REDIS_URL="redis://localhost:6379"

# Authentication
# Generate a real secret for any non-local environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="super-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Browser origins allowed by CORS, comma-separated (Expo web dev server below).
# Native apps need none; leave empty to keep CORS off.
CORS_ORIGINS=http://localhost:8081

# Rate limiting (requests per window, per client)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Serve Swagger UI at /docs and the spec at /docs/openapi.json
SWAGGER_ENABLED=true

# Days raw price observations are kept before pruning
PRICE_OBSERVATION_RETENTION_DAYS=90

# Evidence photo storage: local (one directory) or s3 (any S3-compatible store)
EVIDENCE_STORAGE_DRIVER=local
# Directory for uploaded price evidence photos (local driver)
EVIDENCE_STORAGE_DIR=var/evidence
# Object store (s3 driver). The values below target the compose stack's S3 mock;
# against AWS, drop the endpoint and path style, and omit the keys to use a role.
# EVIDENCE_S3_BUCKET=garner-evidence
# EVIDENCE_S3_REGION=us-east-1
# EVIDENCE_S3_ENDPOINT=http://127.0.0.1:9090
# EVIDENCE_S3_FORCE_PATH_STYLE=true
# EVIDENCE_S3_ACCESS_KEY_ID=test
# EVIDENCE_S3_SECRET_ACCESS_KEY=test

# Bearer tokens for external price sources: {"source-slug":"token"}
EXTERNAL_SOURCE_TOKENS={}

# Directory the sandbox price-source adapter reads fixtures from
EXTERNAL_SOURCE_SANDBOX_DIR=var/sandbox-sources

# Days delivered notifications are kept before pruning
NOTIFICATION_RETENTION_DAYS=30

# Email notifications. Unset SMTP_URL to offer the in-app inbox only.
# The value below is the compose stack's Mailpit (web inbox: http://localhost:8025).
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Garner <alerts@garner.local>"
# Where the API is reachable from outside, for unsubscribe links in emails
PUBLIC_BASE_URL=http://localhost:3000

# Observability and hardening
# LOG_FORMAT=json          # json outside development, pretty locally
TRUST_PROXY_HOPS=0         # proxies in front of the API; wrong breaks per-IP limits
MAX_REQUEST_BODY_KB=256

# Tracing. Set an OTLP/HTTP collector to export spans; unset, trace ids are
# still minted and propagated, and nothing is recorded.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=garner-api
# OTEL_TRACES_SAMPLE_RATIO=1

# Days finished optimizations are kept before pruning
OPTIMIZATION_RETENTION_DAYS=30
