# Application
NODE_ENV=development
PORT=3000

# Database URLs (one per logical database)
CORE_DB_URL="postgresql://postgres:password@localhost:5433/core_db?schema=public"
PRICING_DB_URL="postgresql://postgres:password@localhost:5433/pricing_db?schema=public"
INTELLIGENCE_DB_URL="postgresql://postgres:password@localhost:5433/intelligence_db?schema=public"

# Redis (cache + BullMQ)
REDIS_URL="redis://localhost:6379"

# Authentication
# Generate a real secret for any non-local environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="super-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Rate limiting (requests per window, per client)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Serve Swagger UI at /docs and the spec at /docs/openapi.json
SWAGGER_ENABLED=true

# Days raw price observations are kept before pruning
PRICE_OBSERVATION_RETENTION_DAYS=90

# Directory for uploaded price evidence photos (local-disk storage)
EVIDENCE_STORAGE_DIR=var/evidence

# Bearer tokens for external price sources: {"source-slug":"token"}
EXTERNAL_SOURCE_TOKENS={}

# Directory the sandbox price-source adapter reads fixtures from
EXTERNAL_SOURCE_SANDBOX_DIR=var/sandbox-sources
