# Loaded ahead of .env when NODE_ENV=test (see AppConfigModule).
# Committed on purpose: these point only at local throwaway test databases and
# contain no real secret.
NODE_ENV=test
PORT=3001

CORE_DB_URL="postgresql://postgres:password@localhost:5433/core_db_test?schema=public"
PRICING_DB_URL="postgresql://postgres:password@localhost:5433/pricing_db_test?schema=public"
INTELLIGENCE_DB_URL="postgresql://postgres:password@localhost:5433/intelligence_db_test?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="test-secret-not-used-anywhere-real"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Raised so functional tests are not throttled; rate limiting has its own test.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000

SWAGGER_ENABLED=false

PRICE_OBSERVATION_RETENTION_DAYS=90
EVIDENCE_STORAGE_DIR=var/test-evidence
EXTERNAL_SOURCE_TOKENS={}
EXTERNAL_SOURCE_SANDBOX_DIR=var/test-sandbox-sources
NOTIFICATION_RETENTION_DAYS=30
LOG_FORMAT=pretty
TRUST_PROXY_HOPS=0
MAX_REQUEST_BODY_KB=256
LOG_FORMAT=pretty
TRUST_PROXY_HOPS=0
MAX_REQUEST_BODY_KB=256
OPTIMIZATION_RETENTION_DAYS=30
